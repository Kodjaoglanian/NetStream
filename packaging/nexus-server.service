[Unit]
Description=NexusMesh control plane (coordination, IPAM, STUN)
Documentation=https://github.com/Kodjaoglanian/NetStream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nexus
Group=nexus
EnvironmentFile=-/etc/nexus/server.env
ExecStart=/usr/local/bin/nexus-server serve
Restart=on-failure
RestartSec=3

# Hardening — needs only its state dir and the STUN port.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/nexus
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
