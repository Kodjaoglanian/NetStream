[Unit]
Description=NexusMesh node agent (P2P mesh VPN dataplane)
Documentation=https://github.com/Kodjaoglanian/NetStream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/nexus/agent.env
ExecStart=/usr/local/bin/nexus-agent
Restart=on-failure
RestartSec=3

# The agent needs root/CAP_NET_ADMIN for the TUN device and `ip` commands.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
